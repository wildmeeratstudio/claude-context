  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ClearRequest": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "clear"
            ],
            "description": "* Path to the codebase collection to clear",
            "nullable": false
          },
          "codebasePath": {
            "type": "string",
            "nullable": false
          }
        }
      },
      "IndexRequest": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "index"
            ],
            "description": "* Absolute path to the codebase directory",
            "nullable": false
          },
          "codebasePath": {
            "type": "string",
            "description": "* Unique session ID for tracking progress",
            "nullable": false
          },
          "sessionId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "GetRelativePathsRequest": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "get_relative_paths"
            ],
            "description": "* Path to the indexed codebase",
            "nullable": false
          },
          "codebasePath": {
            "type": "string",
            "nullable": false
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "search"
            ],
            "description": "* Path to the indexed codebase",
            "nullable": false
          },
          "codebasePath": {
            "type": "string",
            "description": "* Search query in natural language",
            "nullable": false
          },
          "query": {
            "type": "string",
            "description": "* Maximum number of results to return (default: 5)",
            "nullable": false
          },
          "maxResults": {
            "type": "number",
            "description": "* Similarity threshold (0-1, default: 0.5)",
            "nullable": true
          },
          "threshold": {
            "type": "number",
            "description": "* Optional filter expression for metadata fields",
            "nullable": true
          },
          "filter": {
            "type": "string",
            "nullable": true
          }
        }
      }
    },
